{
  "name": "@task-assistant/http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/server.js",
    "start:watch": "node --watch dist/server.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@task-assistant/application": "workspace:*",
    "@task-assistant/infrastructure": "workspace:*",
    "fastify": "5.6.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "7.0.2"
  }
}
