{
  "name": "task-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A personal daily task-reminder companion.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist apps/*/dist",
    "db:generate": "pnpm --filter @task-assistant/infrastructure db:generate",
    "dev": "pnpm build && concurrently -k \"tsc -b -w --preserveWatchOutput\" \"pnpm --filter @task-assistant/http start:watch\"",
    "start": "pnpm --filter @task-assistant/http start",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "concurrently": "9.2.1",
    "typescript": "7.0.2"
  }
}
