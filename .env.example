# HTTP Server
APP_HOST=0.0.0.0
APP_PORT=3000

# Time & Scheduling
USER_TIMEZONE=Europe/London
DELIVERY_LOCAL_TIME=10:00
DELIVERY_JITTER_MINUTES=10

# External Task API
TASK_PROVIDER=todoist

# External Messaging API
MESSAGE_CHANNEL=telegram
TELEGRAM_RECEIVER_MODE=polling

# External AI Provider
MODEL_PROVIDER=openai

# Storage
STATE_DIR=./data