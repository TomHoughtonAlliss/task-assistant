      "types": "./dist/daily-review-persistence/index.d.ts",
      "default": "./dist/daily-review-persistence/index.js"
    },
    "./daily-run-guard": {
      "types": "./dist/daily-run-guard/index.d.ts",
      "default": "./dist/daily-run-guard/index.js"
    },
    "./message-channel": {
      "types": "./dist/message-channel/index.d.ts",
      "default": "./dist/message-channel/index.js"
