{
  "name": "task-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "A personal daily task-reminder companion.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch src/entrypoints/http/server.ts",
    "start": "node dist/entrypoints/http/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.27",
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.44.5",
    "fastify": "5.6.1",
    "ai": "7.0.40",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/better-sqlite3": "7.6.13",
    "drizzle-kit": "0.31.6",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
