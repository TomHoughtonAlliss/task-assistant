# HTTP Server
APP_HOST=0.0.0.0
APP_PORT=3000

# Time & Scheduling
USER_TIMEZONE=Europe/London
DELIVERY_LOCAL_TIME=10:00
DELIVERY_JITTER_MINUTES=10

# External Task API
TASK_PROVIDER=todoist
TODOIST_API_TOKEN=
TODOIST_API_BASE_URL=https://api.todoist.com/api/v1

# External Messaging API
MESSAGE_CHANNEL=telegram
TELEGRAM_RECEIVER_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# External AI Provider
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# Storage
STATE_DIR=./data
DISABLE_DAILY_RUN_GUARD=false
